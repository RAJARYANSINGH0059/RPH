# ---------- Backend (apps/api) ----------
APP_ENV=development
DATABASE_URL=sqlite:///./ps05x.db          # Render: postgresql+psycopg://user:pass@host:5432/db (set from Render Postgres "Internal Database URL")
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:3000         # production: your custom domain(s), comma-separated
CORS_ORIGIN_REGEX=                         # production: ^https://[a-z0-9-]+\.vercel\.app$
STORAGE_DIR=./data                         # Render: /var/data if a persistent disk is attached (ephemeral otherwise)
BENCHMARK_STORE_DIR=./data/sealed          # sealed synthetic ground truth; never served by case APIs
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=200

# OCR: auto (Tesseract if installed, else RapidOCR), tesseract, rapidocr, off
OCR_ENGINE=auto
TESSERACT_CMD=                             # optional explicit path to the tesseract binary

# Durable evidence storage (S3-compatible: AWS S3, Cloudflare R2, MinIO). Leave STORAGE_BACKEND=local for development.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=                           # e.g. https://<accountid>.r2.cloudflarestorage.com ; blank for AWS
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=ps05x

# Demo accounts are created at startup ONLY when a password is set. Leave blank to disable.
DEMO_ANALYST_EMAIL=analyst@demo.local
DEMO_ANALYST_PASSWORD=
DEMO_SUPERVISOR_EMAIL=supervisor@demo.local
DEMO_SUPERVISOR_PASSWORD=
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=

# Optional connectors (all off by default; synthetic mode needs none of these)
ENABLE_RDAP=false
ENABLE_DNS=false
URLHAUS_AUTH_KEY=
THREATFOX_AUTH_KEY=
MISP_URL=
MISP_KEY=
CONNECTOR_TIMEOUT_SECONDS=6

# ---------- Optional keyed features (digital-twin increment) ----------
PROOF_SIGNING_KEY=              # optional: HMAC-SHA256 over proof manifests; unset = hash-only manifests
PROOF_SIGNING_KEY_VERSION=v1
CROSSCASE_TOKEN_KEY=            # optional: keyed-token privacy matching; unset = feature reports disabled

# ---------- Frontend (apps/web) ----------
API_BASE_URL=http://localhost:8000               # server-side base used by the BFF routes (falls back to NEXT_PUBLIC_API_BASE_URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # production: https://<your-render-service>.onrender.com
